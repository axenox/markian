{
  "name": "markian",
  "version": "0.1.0",
  "format": "classic-script",
  "sourceMaps": false,
  "core": {
    "script": "markian.min.js",
    "stylesheet": "markian.css",
    "contentStylesheet": "markdown-github.css",
    "types": "types/index.d.ts"
  },
  "viewer": {
    "script": "markian-viewer.min.js",
    "stylesheet": "markian-viewer.css",

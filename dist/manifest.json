    "global": "MarkianViewer",
    "dependencies": [],
    "measurements": "sizes.json"
  },
  "extensions": {
    "code": {
      "script": "extensions/code.min.js",
      "stylesheet": "extensions/code.css",
      "types": "types/extensions/code.d.ts",
      "global": "MarkianCode.codeExtension",
      "requires": "0.1.0",
      "dependencies": [
        {
          "name": "highlight.js",
          "version": "11.12.0",
          "bundled": true,
          "apiVersion": 1,
          "loading": "Only the selected fence language; no editing engines in language assets",
          "languages": [
            {
              "id": "javascript",
              "script": "extensions/languages/javascript.min.js",
              "global": "MarkianCodeLanguage_javascript.highlighter"
            },
            {
              "id": "typescript",
              "script": "extensions/languages/typescript.min.js",
              "global": "MarkianCodeLanguage_typescript.highlighter"
            },
            {
              "id": "json",
              "script": "extensions/languages/json.min.js",
              "global": "MarkianCodeLanguage_json.highlighter"
            },
            {
              "id": "css",
              "script": "extensions/languages/css.min.js",
              "global": "MarkianCodeLanguage_css.highlighter"
            },
            {
              "id": "html",
              "script": "extensions/languages/html.min.js",
              "global": "MarkianCodeLanguage_html.highlighter"
            },
            {
              "id": "php",
              "script": "extensions/languages/php.min.js",
              "global": "MarkianCodeLanguage_php.highlighter"
            },
            {
              "id": "sql",
              "script": "extensions/languages/sql.min.js",
              "global": "MarkianCodeLanguage_sql.highlighter"
            },
            {
              "id": "python",
              "script": "extensions/languages/python.min.js",
              "global": "MarkianCodeLanguage_python.highlighter"
            },
            {
              "id": "yaml",
              "script": "extensions/languages/yaml.min.js",
              "global": "MarkianCodeLanguage_yaml.highlighter"
            }
          ]
        }
      ]
    },
    "mermaid": {
      "script": "extensions/mermaid.min.js",
      "stylesheet": "extensions/mermaid.css",
      "types": "types/extensions/mermaid.d.ts",
      "global": "MarkianMermaid.mermaidExtension",
      "requires": "0.1.0",
      "dependencies": [
        {
          "name": "mermaid",
          "testedVersion": "12.2.0",
          "requiredApi": [
            "initialize",
            "render"
          ],
          "external": true,
          "loading": "host-configured source URL or supplied renderer adapter"
        }
      ]
    },
    "viewerMermaid": {
      "script": "extensions/viewer-mermaid.min.js",
      "stylesheet": "extensions/viewer-mermaid.css",
      "types": "types/viewer-mermaid.d.ts",
      "global": "MarkianViewerMermaid.createRenderer",
      "requires": "0.1.0",
      "dependencies": [
        {
          "name": "mermaid",
          "testedVersion": "12.2.0",
          "requiredApi": [
            "initialize",
            "render"
          ],
          "external": true,
          "loading": "Explicit mermaid:true plus a matching fence and host-configured source URL or supplied renderer"
        }
      ]
    }
  },
